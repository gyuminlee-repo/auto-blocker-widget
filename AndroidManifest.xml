<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gml.autoblocker">

    <!-- 권한이 아니다. API 30+ 에서 Play 스토어 실행 Intent 를 얻으려면 패키지가 보여야 한다. -->
    <queries>
        <package android:name="com.android.vending" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:localeConfig="@xml/locales_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/MainTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 앱 바로가기 두 개. 바로가기만 실행할 수 있는 자동화 앱용이다(res/xml/shortcuts.xml). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <receiver
            android:name=".AutoBlockerWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <!-- 덮어 설치 뒤 런처가 위젯을 initialLayout 으로 되돌리므로 다시 그린다(AutoBlockerWidget.onReceive). -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- 런처가 위젯을 놓거나 다시 설정할 때 연다. 이 앱 위젯 id 만 받는다(WidgetConfigActivity). -->
        <activity
            android:name=".WidgetConfigActivity"
            android:exported="true"
            android:label="@string/style_title"
            android:theme="@style/MainTheme">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- taskAffinity="" 로 앱 작업(MainActivity)과 섞이지 않게 한다. 섞이면 BACK 이 원래 화면 대신 설정 안내로 간다. -->
        <activity
            android:name=".TrampolineActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- 자동화 앱이 켜기 또는 끄기를 요청하는 입구. 켜기는 보호를 높이기만 하고 끄기는 One UI 인증을 거치므로
             호출자 권한을 요구하지 않는다(MacroDroid, Tasker 는 사용자 정의 권한을 가질 수 없다). -->
        <activity
            android:name=".ActionActivity"
            android:exported="true"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="com.gml.autoblocker.action.TURN_ON" />
                <action android:name="com.gml.autoblocker.action.TURN_OFF" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".AutoTapService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 빠른 설정 타일. 시스템이 바인드하므로 exported 가 필요하고 BIND_QUICK_SETTINGS_TILE 로 보호한다. -->
        <service
            android:name=".ShieldTile"
            android:exported="true"
            android:icon="@drawable/ic_shield_on"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 3×1 위젯의 Play 프로텍트 버튼이 여는 입구. 처음 한 번 안내 창을 띄우고 설정 화면만 연다. 아무것도 바꾸지 않는다. 트램펄린과 같은 작업 설정. -->
        <activity
            android:name=".PlayProtectActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/PlayProtectTheme" />

        <!-- 위젯 목록의 3×1 항목(Play 프로텍트 바로가기 포함). 위 2×1 과 별도 provider 라 목록에 둘 다 보인다.
             언어 변경은 2×1 receiver 의 refresh() 가 두 provider 를 함께 다시 그리므로 여기서는 받지 않는다. -->
        <receiver
            android:name=".AutoBlockerWideWidget"
            android:exported="false"
            android:label="@string/widget_wide_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_wide" />
        </receiver>
    </application>
</manifest>
