<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/style_title"
            android:textAppearance="@android:style/TextAppearance.DeviceDefault.Large" />

        <RadioGroup
            android:id="@+id/style_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/style_color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/style_color" />
            <RadioButton
                android:id="@+id/style_mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/style_mono" />
            <RadioButton
                android:id="@+id/style_custom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/style_custom" />
            <!-- API 31 이상에서만 보인다(WidgetConfigActivity). -->
            <RadioButton
                android:id="@+id/style_system"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/style_system"
                android:visibility="gone" />
        </RadioGroup>

        <TextView
            android:id="@+id/style_system_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/style_system_hint"
            android:visibility="gone" />

        <!-- 사용자 지정일 때만 보인다. 상태별 바탕색 #RRGGBB. -->
        <LinearLayout
            android:id="@+id/custom_fields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@+id/color_on"
                android:text="@string/color_on" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- 누르면 색 고르기 창. 바탕은 코드에서 원형 견본으로 그린다. -->
                <View
                    android:id="@+id/swatch_on"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/color_on" />
                <EditText
                    android:id="@+id/color_on"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:hint="@string/hex_hint"
                    android:inputType="text|textNoSuggestions"
                    android:maxLength="7"
                    android:singleLine="true" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:labelFor="@+id/color_off"
                android:text="@string/color_off" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- 누르면 색 고르기 창. 바탕은 코드에서 원형 견본으로 그린다. -->
                <View
                    android:id="@+id/swatch_off"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/color_off" />
                <EditText
                    android:id="@+id/color_off"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:hint="@string/hex_hint"
                    android:inputType="text|textNoSuggestions"
                    android:maxLength="7"
                    android:singleLine="true" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:labelFor="@+id/color_unknown"
                android:text="@string/color_unknown" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- 누르면 색 고르기 창. 바탕은 코드에서 원형 견본으로 그린다. -->
                <View
                    android:id="@+id/swatch_unknown"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/color_unknown" />
                <EditText
                    android:id="@+id/color_unknown"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:hint="@string/hex_hint"
                    android:inputType="text|textNoSuggestions"
                    android:maxLength="7"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- 위젯별 언어. 기본은 앱 언어 따라감(WidgetConfigActivity). -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/widget_lang_title"
            android:textAppearance="@android:style/TextAppearance.DeviceDefault.Large" />

        <RadioGroup
            android:id="@+id/widget_lang_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/widget_lang_app"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/widget_lang_app" />
            <RadioButton
                android:id="@+id/widget_lang_en"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/lang_en" />
            <RadioButton
                android:id="@+id/widget_lang_ko"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/lang_ko" />
        </RadioGroup>

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/btn_save" />
    </LinearLayout>
</ScrollView>
