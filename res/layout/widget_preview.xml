<?xml version="1.0" encoding="utf-8"?>
<!-- 위젯 고르기 화면의 미리보기(API 31+, widget_info.xml previewLayout). 컬러 스타일 켜짐 상태를 고정으로 그린다. 확인 시각은 뺐다. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_on">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_shield_on"
            android:tint="@color/widget_fg_light" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_fg_light"
            android:textSize="20sp"
            android:textStyle="bold"
            android:text="@string/state_on" />
    </LinearLayout>
</FrameLayout>
